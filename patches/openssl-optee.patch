index 95c4ff8..17016c2 100644
--- a/providers/implementations/rands/seeding/rand_unix.c
+++ b/providers/implementations/rands/seeding/rand_unix.c
@@ -7,6 +7,86 @@
  * https://www.openssl.org/source/license.html
  */
 
+
+/* OPTEE RNG BACKEND */
+#if defined(OPENSSL_SYS_OPTEE)
+
+#include <stddef.h>
+#include <tee_internal_api.h>
+
+#include "crypto/rand.h"
+#include "crypto/rand_pool.h"
+
+/* No Linux random devices need initialization. */
+int ossl_rand_pool_init(void)
+{
+    return 1;
+}
+
+void ossl_rand_pool_cleanup(void)
+{
+}
+
+void ossl_rand_pool_keep_random_devices_open(int keep)
+{
+    (void)keep;
+}
+
+/* Supply entropy to OpenSSL's seed source. */
+size_t ossl_pool_acquire_entropy(RAND_POOL *pool)
+{
+    size_t n;
+    unsigned char *buffer;
+
+    if (pool == NULL)
+        return 0;
+
+    n = ossl_rand_pool_bytes_needed(pool, 1);
+
+    if (n == 0)
+        return ossl_rand_pool_entropy_available(pool);
+
+    buffer = ossl_rand_pool_add_begin(pool, n);
+
+    if (buffer == NULL)
+        return 0;
+
+    TEE_GenerateRandom(buffer, n);
+
+    if (!ossl_rand_pool_add_end(pool, n, n * 8))
+        return 0;
+
+    return ossl_rand_pool_entropy_available(pool);
+}
+
+/* Supply fresh nonce data without using PID or wall-clock time. */
+int ossl_pool_add_nonce_data(RAND_POOL *pool)
+{
+    size_t n;
+    unsigned char *buffer;
+
+    if (pool == NULL)
+        return 0;
+
+    n = pool->min_len;
+
+    if (n < 16)
+        n = 16;
+
+    if (n > ossl_rand_pool_bytes_remaining(pool))
+        return 0;
+
+    buffer = ossl_rand_pool_add_begin(pool, n);
+
+    if (buffer == NULL)
+        return 0;
+
+    TEE_GenerateRandom(buffer, n);
+
+    return ossl_rand_pool_add_end(pool, n, 0);
+}
+
+#else /* Original OpenSSL platform backend */
 #ifndef _GNU_SOURCE
 #define _GNU_SOURCE
 #endif
