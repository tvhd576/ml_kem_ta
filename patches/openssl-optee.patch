+/* OPTEE_HTTP_PORT_PARSER */
+#if defined(OPENSSL_SYS_OPTEE)
+static int optee_parse_port(const char *s, unsigned int *value)
+{
+    unsigned int number = 0;
+
+    if (*s < '0' || *s > '9')
+        return 0;
+
+    while (*s >= '0' && *s <= '9') {
+        unsigned int digit = (unsigned int)(*s - '0');
+
+        if (number > (65535U - digit) / 10U)
+            return 0;
+
+        number = number * 10U + digit;
+        s++;
+    }
+
+    *value = number;
+    return 1;
+}
+#endif
+
+
+
 #include <stdio.h> /* for sscanf() */
 #include <string.h>
 #include <openssl/http.h>
@@ -127,7 +153,11 @@ int OSSL_parse_url(const char *url, char **pscheme, char **puser, char **phost,
         port = ++p;
     /* remaining port spec handling is also done for the default values */
     /* make sure a decimal port number is given */
+    #if defined(OPENSSL_SYS_OPTEE)
+    if (!optee_parse_port(port, &portnum)) {
+#else
     if (sscanf(port, "%u", &portnum) <= 0 || portnum > 65535) {
+#endif
         ERR_raise_data(ERR_LIB_HTTP, HTTP_R_INVALID_PORT_NUMBER, "%s", port);
         goto err;
     }
